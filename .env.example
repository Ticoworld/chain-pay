# ChainPay environment

# --- CKB ---
# Light client mode. Embedded WASM is the default; remote RPC is fallback only.
CKB_NETWORK=mainnet                          # mainnet | testnet
CKB_LIGHT_CLIENT_MODE=embedded               # embedded | remote
CKB_REMOTE_RPC_URL=                          # only used if mode=remote

# --- EVM ---
# Comma-separated list of EVM chain IDs to enable. 11155111=Sepolia.
EVM_ENABLED_CHAINS=11155111,1,42161,10,8453

# Per-chain RPC overrides. Leave blank to use public defaults from viem/wagmi.
EVM_RPC_URL_1=
EVM_RPC_URL_42161=
EVM_RPC_URL_10=
EVM_RPC_URL_8453=

# Renderer-visible endpoint for Sepolia Safe reads.
# Leave blank to use viem's Sepolia public default.
VITE_EVM_SEPOLIA_RPC_URL=
# Main-process endpoint for Sepolia Safe receipt and accounting evidence.
EVM_SEPOLIA_RPC_URL=

# WalletConnect v2 project id (required only when WalletConnect signer transport is enabled)
VITE_WALLETCONNECT_PROJECT_ID=

# Safe Transaction Service relay. Leave blank for self-coordinate mode (default).
SAFE_TX_SERVICE_URL=

# --- Bitcoin watch-only (Phase 5 Slice A) ---
# Esplora-compatible providers are called only by the Electron main process.
# No provider URL or bearer token is exposed through renderer state or IPC responses.
# HTTPS is required except for loopback development providers.
BITCOIN_MAINNET_ESPLORA_URL=
BITCOIN_MAINNET_ESPLORA_BEARER_TOKEN=
BITCOIN_TESTNET_ESPLORA_URL=
BITCOIN_TESTNET_ESPLORA_BEARER_TOKEN=

# --- Solana watch and durable-nonce payment (Phase 5 Slice B) ---
# Provider credentials stay in Electron main; HTTPS is required outside loopback.
SOLANA_DEVNET_RPC_URL=
SOLANA_DEVNET_RPC_BEARER_TOKEN=
SOLANA_MAINNET_RPC_URL=
SOLANA_MAINNET_RPC_BEARER_TOKEN=

# --- Frappe backend (Phase 4) ---
FRAPPE_URL=http://chainpay.localhost:8000
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# --- Pricing (FX snapshot at payment calc time) ---
PRICE_PROVIDER=coingecko                     # coingecko | coinbase | manual
COINGECKO_API_KEY=

# ---- Phase 5 / Slice B: Frappe backend ----
ERPNEXT_IMAGE=frappe/erpnext:version-15
MARIADB_ROOT_PASSWORD=frappe
ADMIN_PASSWORD=admin
SITE_NAME=chainpay.localhost
BACKEND_PORT=8000
