{
  "name": "@chain-pay/desktop",
  "version": "0.1.0-phase0",
  "private": true,
  "type": "module",
  "description": "ChainPay desktop application (Electron + React)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src electron",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@biscuit-auth/biscuit-wasm": "^0.6.0",
    "@chain-pay/shared": "*",
    "@ckb-ccc/core": "^1.12.0",
    "@hookform/resolvers": "^3.9.0",
    "@joyid/ckb": "^1.1.4",
    "@nervosnetwork/ckb-light-client-js": "^0.5.5",
    "@noble/curves-v1": "npm:@noble/curves@1.9.7",
    "@noble/curves-v2": "npm:@noble/curves@2.2.0",
    "@safe-global/api-kit": "^3.0.0",
    "@safe-global/protocol-kit": "^5.0.0",
    "@scure/bip32": "2.2.0",
    "@scure/btc-signer": "2.2.0",
    "@solana/web3.js": "1.98.4",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.0",
    "@walletconnect/universal-provider": "2.23.10",
    "bonjour-service": "^1.4.0",
    "bs58": "6.0.0",
    "buffer": "^6.0.3",
    "cemp-pq": "*",
    "clsx": "^2.1.1",
    "json-bigint": "1.0.0",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "7.18.2",
    "recharts": "^2.13.0",
    "selfsigned": "^2.4.1",
    "tailwind-merge": "^2.5.0",
    "tesseract.js": "^5.1.1",
    "viem": "^2.21.0",
    "wagmi": "^2.13.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/json-bigint": "1.0.4",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.6",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.65.0",
    "undici": "6.28.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "io.chainpay.desktop",
    "productName": "ChainPay",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
